<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQBot Studio 控制台" Width="980" Height="650"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" Background="#0B1220"
        FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EDF7"/>
      <Setter Property="Background" Value="#141D30"/>
      <Setter Property="BorderBrush" Value="#223049"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="18,14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1C2942"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#3E72C9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#24334F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="#8A98AE"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1C2942"/>
                <Setter Property="Foreground" Value="#E6EDF7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MiniBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#25406E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E5288"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1C3358"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="#0B1220" BorderBrush="#243352" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="#0E1626">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Image x:Name="imgMark" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="QQBot Studio" Foreground="#C9D6EA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Background="#182236" CornerRadius="7" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="控制台 v1.2.6" Foreground="#7E8CA6" FontSize="11"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="btnMin" Style="{StaticResource Chrome}" Content="&#x2013;"/>
          <Button x:Name="btnMax" Style="{StaticResource Chrome}" Content="&#x2610;"/>
          <Button x:Name="btnClose" Style="{StaticResource Chrome}" Content="&#x2715;"/>
        </StackPanel>
      </Grid>

      <!-- body -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="272"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#182236" BorderThickness="0,0,1,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#0E1728" Offset="0"/>
              <GradientStop Color="#0B1220" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel Margin="20,22,20,18">
            <Image x:Name="imgLogo" Height="64" HorizontalAlignment="Left" Stretch="Uniform"/>
            <TextBlock Text="霖雨 · AI QQ 机器人框架" Foreground="#8A98AE" FontSize="12" Margin="0,12,0,0"/>
            <Rectangle Height="1" Fill="#1C2740" Margin="0,16,0,14"/>

            <Border x:Name="pillCfg" CornerRadius="10" Background="#141D30" BorderBrush="#223049" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="dotCfg" Width="9" Height="9" Fill="#FFB25C" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="txtCfg" Text="配置状态：未配置" Foreground="#D7E1F0" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border x:Name="pillRun" CornerRadius="10" Background="#141D30" BorderBrush="#223049" BorderThickness="1" Padding="12,8">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="dotRun" Width="9" Height="9" Fill="#8A98AE" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="txtRun" Text="运行状态：已停止" Foreground="#D7E1F0" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <TextBlock Text="提示" Foreground="#4DA3FF" FontSize="12" FontWeight="SemiBold" Margin="2,20,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="#6F7D95" FontSize="11.5" LineHeight="18"
                       Text="首次使用请先「安装 / 重新配置」。运行机器人前记得先启动 NapCat 并登录 QQ。"/>

            <Border CornerRadius="12" Margin="0,18,0,0" Padding="14,12"
                    Background="#132039" BorderBrush="#2E4776" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="官方交流群" Foreground="#8FB6FF" FontSize="11.5"/>
                <TextBlock x:Name="txtGroup" Text="1130036800" Foreground="#FFFFFF" FontSize="24"
                           FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,2,0,2"/>
                <TextBlock Text="遇到问题？进来问问，也欢迎来玩～" Foreground="#8A98AE" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button x:Name="btnGroup" Style="{StaticResource MiniBtn}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="＋  加入 QQ 群 (复制群号)" FontSize="12.5"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="16,14,16,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,8">
              <TextBlock Text="操作面板" Foreground="#E6EDF7" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="选择下面的操作来管理你的机器人" Foreground="#6F7D95" FontSize="12" Margin="12,3,0,0"/>
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="2" Rows="4">
              <Button x:Name="btnInstall" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="⚙  安装 / 重新配置" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="检查环境、装依赖、生成 config.json" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnStart" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="▶  启动机器人" FontSize="16" FontWeight="SemiBold" Foreground="#A9F0D2"/>
                  <TextBlock Text="在新窗口运行 bot.py" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnStop" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="■  停止机器人" FontSize="16" FontWeight="SemiBold" Foreground="#FFB0BE"/>
                  <TextBlock Text="结束正在运行的机器人进程" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnLog" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="≡  查看运行日志" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="实时跟踪 bot.log" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnDoc" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="▤  图文说明书" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="打开新手上手指南" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnFolder" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="▣  打开本文件夹" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="在资源管理器中查看文件" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnShortcut" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="✦  创建桌面快捷方式" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="在桌面生成一键启动图标" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnQuit" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="⏻  退出" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="关闭控制台（不影响机器人）" FontSize="11.5" Foreground="#8A98AE" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
            </UniformGrid>
          </Grid>
        </Border>
      </Grid>

      <!-- status bar -->
      <Grid Grid.Row="2" Background="#0E1626">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="txtMsg" Grid.Column="0" Foreground="#6F7D95" FontSize="11.5" VerticalAlignment="Center" Margin="16,0,0,0"
                   Text="就绪"/>
        <Button x:Name="btnRefresh" Grid.Column="1" Style="{StaticResource Chrome}" Content="↻" FontSize="15" ToolTip="刷新状态"/>
      </Grid>
    </Grid>
  </Border>
</Window>
