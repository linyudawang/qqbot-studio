# AI 机器人框架 · 密钥文件模板
# 复制为 .env 后填入真实值。.env 不要提交到 git，也不要分享。
# 优先级：config.json 里填了就用 config.json；留空则回退到这里的同名环境变量。
#
# 这些 key 也可以只填在 config.json，二选一即可。

# ---- 对话大模型（OpenAI 兼容）----
# DeepSeek 官方
DEEPSEEK_API_KEY=
# 也可以指向任意 OpenAI 兼容服务（会用到 *_base 配置）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- 图像生成（智谱 GLM / CogView 等）----
T2I_API_KEY=

# ---- 图像搜索（Bing 可选）----
BING_API_KEY=

# ---- 虚拟形象生成（火山方舟 ARK / 豆包 seedream，可选）----
ARK_API_KEY=
